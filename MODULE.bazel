"""agk-orchestrator: deployable multi-agent app on AgenticGoKit using local MLX."""

module(
    name = "agk_orchestrator",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.4", dev_dependency = True)

# Hermetic Go SDK (does not use the host toolchain).
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.3")

# Static analysis (go vet set) wired into every build/test.
go_sdk.nogo(nogo = "//:nogo")

# External Go module dependencies, driven by go.mod.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_agenticgokit_agenticgokit", "com_github_burntsushi_toml")

# golangci-lint binaries, fetched hermetically; run via //tools/lint:golangci-lint.
# Declared for every host we lint on: linux/amd64 (CI), linux/arm64 (Pi),
# macOS/amd64 (Intel), and macOS/arm64 (Apple silicon).
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "golangci_lint_linux_amd64",
    build_file_content = 'exports_files(["golangci-lint"])',
    sha256 = "2277d43b98ec0054280f2ac26b53268bae97682444678a59a657dd565da021d6",
    strip_prefix = "golangci-lint-2.13.2-linux-amd64",
    urls = ["https://github.com/golangci/golangci-lint/releases/download/v2.13.2/golangci-lint-2.13.2-linux-amd64.tar.gz"],
)

http_archive(
    name = "golangci_lint_linux_arm64",
    build_file_content = 'exports_files(["golangci-lint"])',
    sha256 = "a2a4e0065aa41be71f7c5ac90f271b61751331e5d04314e62afe4027855f0893",
    strip_prefix = "golangci-lint-2.13.2-linux-arm64",
    urls = ["https://github.com/golangci/golangci-lint/releases/download/v2.13.2/golangci-lint-2.13.2-linux-arm64.tar.gz"],
)

http_archive(
    name = "golangci_lint_darwin_amd64",
    build_file_content = 'exports_files(["golangci-lint"])',
    sha256 = "8a13aaf9cbbb1dee52824e862cf0d0720e5bb97c1f4260d1e51623a09492b57b",
    strip_prefix = "golangci-lint-2.13.2-darwin-amd64",
    urls = ["https://github.com/golangci/golangci-lint/releases/download/v2.13.2/golangci-lint-2.13.2-darwin-amd64.tar.gz"],
)

http_archive(
    name = "golangci_lint_darwin_arm64",
    build_file_content = 'exports_files(["golangci-lint"])',
    sha256 = "f4bf83f0b64f055c42b28fc9a38861839f69c096e61c788e72dfaae412011789",
    strip_prefix = "golangci-lint-2.13.2-darwin-arm64",
    urls = ["https://github.com/golangci/golangci-lint/releases/download/v2.13.2/golangci-lint-2.13.2-darwin-arm64.tar.gz"],
)
