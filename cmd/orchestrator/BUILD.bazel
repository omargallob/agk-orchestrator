load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

go_library(
    name = "orchestrator_lib",
    srcs = [
        "main.go",
        "run.go",
        "serve.go",
    ],
    importpath = "github.com/omargallob/agk-orchestrator/cmd/orchestrator",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/config",
        "//internal/orchestrator",
        "//internal/server",
    ],
)

go_binary(
    name = "orchestrator",
    embed = [":orchestrator_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "orchestrator_test",
    srcs = [
        "main_test.go",
        "run_test.go",
    ],
    embed = [":orchestrator_lib"],
)

# --- Container image (rules_oci, multi-arch) ---

# The binary at a stable path inside the image.
pkg_tar(
    name = "app_layer",
    srcs = [":orchestrator"],
    package_dir = "/usr/local/bin",
)

# Arch-agnostic image; default entrypoint runs `serve` (the long-lived mode).
# Supply a config at runtime, e.g. `--config /etc/agk/orchestrator.toml`.
# Restricted to linux so `bazel build //...` on a non-linux host skips it.
oci_image(
    name = "image",
    base = "@distroless_static",
    entrypoint = [
        "/usr/local/bin/orchestrator",
        "serve",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    tars = [":app_layer"],
)

platform_transition_filegroup(
    name = "image_linux_amd64",
    srcs = [":image"],
    target_platform = "@rules_go//go/toolchain:linux_amd64",
)

platform_transition_filegroup(
    name = "image_linux_arm64",
    srcs = [":image"],
    target_platform = "@rules_go//go/toolchain:linux_arm64",
)

# Multi-arch manifest list: arm64 for the Pi + amd64.
oci_image_index(
    name = "image_index",
    images = [
        ":image_linux_amd64",
        ":image_linux_arm64",
    ],
)

# `bazel run //cmd/orchestrator:push -- --tag <tag>` publishes the multi-arch image.
oci_push(
    name = "push",
    image = ":image_index",
    repository = "ghcr.io/omargallob/agk-orchestrator",
)
