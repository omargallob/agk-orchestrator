load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "orchestrator_lib",
    srcs = ["main.go"],
    importpath = "github.com/omargallob/agk-orchestrator/cmd/orchestrator",
    visibility = ["//visibility:private"],
    deps = ["@com_github_agenticgokit_agenticgokit//v1beta"],
)

go_binary(
    name = "orchestrator",
    embed = [":orchestrator_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "orchestrator_test",
    srcs = ["main_test.go"],
    embed = [":orchestrator_lib"],
)
